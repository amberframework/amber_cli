name: {{snake_case}}
version: 0.1.0

authors:
  - {{author_name | "Your Name <email@example.com>"}}

crystal: ">= 1.20.0, < 2.0"

license: UNLICENSED

targets:
  {{snake_case}}:
    main: src/{{snake_case}}.cr

dependencies:
  amber:
    github: amberframework/amber
    commit: e5c4ac7f0c1d908c3f3ad9ea4f33d858e1f47a5f # v2.0.0-beta.16
  grant:
    github: crimson-knight/grant
    commit: bf9cb490695860b08f209989be686a0eb42c1019 # v0.28.0
  asset_pipeline:
    github: amberframework/asset_pipeline
    commit: dc2185094f4da66062e4e7fb65fb41a9e46a1287 # v0.40.1
<%# Grant ships its own Postgres and SQLite drivers; only MySQL needs a shard. -%>
<% if @database == "mysql" -%>
  mysql:
    github: crimson-knight/crystal-mysql
    commit: 4ec0bcaddd436bcf19ef5072034fbef3b8282f63 # 0.18.1 (Beryl 0.2.1, TLS 1.3)
<% end -%>
