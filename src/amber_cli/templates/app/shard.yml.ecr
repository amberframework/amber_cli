name: {{snake_case}}
version: 0.1.0

authors:
  - {{author_name | "Your Name <email@example.com>"}}

crystal: ">= 1.20.0, < 2.0"

license: UNLICENSED

targets:
  {{snake_case}}:
    main: src/{{snake_case}}.cr

dependencies:
  amber:
    github: amberframework/amber
    commit: 0830e3fdbc5e05be851c3c7ae7bf03b67be10732 # v2.0.0-beta.15
  grant:
    github: crimson-knight/grant
    commit: b83a82f0261509d4ce1f26fadb318c8ba132a066 # v0.26.0
  asset_pipeline:
    github: amberframework/asset_pipeline
    commit: 84f3188239e43dc6e0bcfd2e72074e8ec67156cd # v0.40.0
<%# Grant ships its own Postgres and SQLite drivers; only MySQL needs a shard. -%>
<% if @database == "mysql" -%>
  mysql:
    github: crimson-knight/crystal-mysql
    commit: 5b6e84e903c850d653360a19f424e274833ba866 # 0.18.0 (Beryl TLS 1.3)
<% end -%>
