name: {{snake_case}}
version: 0.1.0

authors:
  - {{author_name | "Your Name <email@example.com>"}}

crystal: ">= 1.20.0, < 2.0"

license: UNLICENSED

targets:
  {{snake_case}}:
    main: src/{{snake_case}}.cr

dependencies:
  amber:
    github: amberframework/amber
    commit: d291e0930dd22b14a2d10f75a9de063abb0e64e4 # v2.0.0-beta.10
  grant:
    github: crimson-knight/grant
    commit: 6c9da3c8180e612f76ff9ad9c76242a0402ce6d9
  asset_pipeline:
    github: amberframework/asset_pipeline
    version: 0.37.1
<% case @database
when "pg" -%>
  pg:
    github: will/crystal-pg
    version: 0.30.0
<% when "mysql" -%>
  mysql:
    github: crimson-knight/crystal-mysql
    commit: c061324dcef89a200a7a3f86a59b2ebf03f83602
<% else -%>
  sqlite3:
    github: crystal-lang/crystal-sqlite3
    version: 0.23.0
<% end -%>
