name: {{snake_case}}
version: 0.1.0

authors:
  - {{author_name | "Your Name <email@example.com>"}}

crystal: ">= 1.20.0, < 2.0"

license: UNLICENSED

targets:
  {{snake_case}}:
    main: src/{{snake_case}}.cr

<%# INTEGRATION PINS (beta.11): these commits are the heads of amberframework/amber#1451, crimson-knight/grant#73 and amberframework/asset_pipeline#25; they become release-tag commits before merge. -%>
dependencies:
  amber:
    github: amberframework/amber
    commit: 43a361419514b49388d5716c97e5b95d170ba5a8 # 2.0.0-beta.10, fix/1425-respond-with-named-tuple (amberframework/amber#1451)
  grant:
    github: crimson-knight/grant
    commit: fe59cbc5b409f67035cf4383e7293c60674ddb3e # 0.24.0, grant-regex-free-default-path (crimson-knight/grant#73)
  asset_pipeline:
    github: amberframework/asset_pipeline
    commit: abbef01db50e2d4a91b09b5356c0f9309347a8fd # 0.38.0, regex-free-default-require (amberframework/asset_pipeline#25)
<%# Grant ships its own Postgres and SQLite drivers; only MySQL needs a shard. -%>
<% if @database == "mysql" -%>
  mysql:
    github: crimson-knight/crystal-mysql
    commit: c061324dcef89a200a7a3f86a59b2ebf03f83602 # 0.17.0
<% end -%>
