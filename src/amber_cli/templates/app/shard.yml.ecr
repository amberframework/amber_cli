name: {{snake_case}}
version: 0.1.0

authors:
  - {{author_name | "Your Name <email@example.com>"}}

crystal: ">= 1.20.0, < 2.0"

license: UNLICENSED

targets:
  {{snake_case}}:
    main: src/{{snake_case}}.cr

dependencies:
  amber:
    github: amberframework/amber
    commit: 1a9af236afed4a6915214b8d193028e6315d7643 # v2.0.0-beta.14
  grant:
    github: crimson-knight/grant
    commit: b83a82f0261509d4ce1f26fadb318c8ba132a066 # v0.26.0
  asset_pipeline:
    github: amberframework/asset_pipeline
    commit: 757cfca8e7b37bafe1dfe19d98192e6716e03746 # v0.39.0
<%# Grant ships its own Postgres and SQLite drivers; only MySQL needs a shard. -%>
<% if @database == "mysql" -%>
  mysql:
    github: crimson-knight/crystal-mysql
    commit: c061324dcef89a200a7a3f86a59b2ebf03f83602 # 0.17.0
<% end -%>
