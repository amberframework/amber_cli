name: {{snake_case}}
version: 0.1.0

authors:
  - {{author_name | "Your Name <email@example.com>"}}

crystal: ">= 1.20.0, < 2.0"

license: UNLICENSED

targets:
  {{snake_case}}:
    main: src/{{snake_case}}.cr

dependencies:
  amber:
    github: amberframework/amber
    commit: 261cf2d3b4a6f3292fefb8113e71e0fe6900fcee # v2.0.0-beta.16
  grant:
    github: crimson-knight/grant
    commit: 96fe7d9f69bb394009c26eaad3a9c87227122830 # v0.28.2
  asset_pipeline:
    github: amberframework/asset_pipeline
    commit: 9a0447c0e10d645307e8532c7794b89491281210 # v0.40.1
<%# Grant ships its own Postgres and SQLite drivers; only MySQL needs a shard. -%>
<% if @database == "mysql" -%>
  mysql:
    github: crimson-knight/crystal-mysql
    commit: ce9cbfab8ba76f5b6d25386140aca0a409b1d585 # 0.18.1 (Beryl 0.2.1, TLS 1.3)
<% end -%>
