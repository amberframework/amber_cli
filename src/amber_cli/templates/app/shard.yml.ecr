name: {{snake_case}}
version: 0.1.0

authors:
  - {{author_name | "Your Name <email@example.com>"}}

crystal: ">= 1.20.0, < 2.0"

license: UNLICENSED

targets:
  {{snake_case}}:
    main: src/{{snake_case}}.cr

dependencies:
  amber:
    github: amberframework/amber
    commit: d775841a0af43bf512f1c9b704906fccdf8863f7 # 2.0.0-beta.10 on v2-dev
  grant:
    github: crimson-knight/grant
    commit: 623c4bcad284fcee000244c8b26651f925e23ceb # 0.23.4
  asset_pipeline:
    github: amberframework/asset_pipeline
    commit: ac630a4c948080bf45e9b1e66451c48da9a69349 # 0.37.1
<%# Grant ships its own Postgres and SQLite drivers; only MySQL needs a shard. -%>
<% if @database == "mysql" -%>
  mysql:
    github: crimson-knight/crystal-mysql
    commit: c061324dcef89a200a7a3f86a59b2ebf03f83602 # 0.17.0
<% end -%>
